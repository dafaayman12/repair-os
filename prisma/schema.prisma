generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum RepairStatus {
  NEW
  DIAGNOSING
  WAITING_PART
  IN_PROGRESS
  READY
  CLOSED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Customer {
  id        String   @id @default(cuid())
  fullName  String
  phone     String?
  whatsapp  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices   Device[]
  repairs   Repair[]
}

model Device {
  id           String   @id @default(cuid())
  customerId   String
  brand        String
  model        String
  imei         String?  @unique
  serialNumber String?  @unique
  color        String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  repairs      Repair[]
}

model Repair {
  id            String        @id @default(cuid())
  repairNumber  String        @unique
  customerId    String
  deviceId      String
  issue         String
  diagnosis     String?
  status        RepairStatus  @default(NEW)
  paymentStatus PaymentStatus @default(UNPAID)
  priority      Priority      @default(NORMAL)
  laborPrice    Float         @default(0)
  partsCost     Float         @default(0)
  totalPrice    Float         @default(0)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  closedAt      DateTime?

  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  device        Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  partsUsed     RepairPartUsed[]
}

model InventoryItem {
  id               String   @id @default(cuid())
  sku              String   @unique
  name             String
  category         String
  compatibleModels String?
  quantityInStock  Int      @default(0)
  minStock         Int      @default(0)
  buyPrice         Float    @default(0)
  sellPrice        Float?
  supplierId       String?
  location         String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplier         Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  partsUsed        RepairPartUsed[]
  purchaseItems    PurchaseItem[]
}

model RepairPartUsed {
  id              String        @id @default(cuid())
  repairId        String
  inventoryItemId String
  quantity        Int           @default(1)
  unitCost        Float         @default(0)
  totalCost       Float         @default(0)
  createdAt       DateTime      @default(now())

  repair          Repair        @relation(fields: [repairId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
}

model Supplier {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  whatsapp       String?
  city           String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  inventoryItems InventoryItem[]
  purchases      Purchase[]
}

model Purchase {
  id             String        @id @default(cuid())
  purchaseNumber String        @unique
  supplierId     String
  totalCost      Float         @default(0)
  paymentStatus  PaymentStatus @default(UNPAID)
  purchasedAt    DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  supplier       Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items          PurchaseItem[]
}

model PurchaseItem {
  id              String        @id @default(cuid())
  purchaseId      String
  inventoryItemId String
  quantity        Int           @default(1)
  unitCost        Float         @default(0)
  totalCost       Float         @default(0)

  purchase        Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
}